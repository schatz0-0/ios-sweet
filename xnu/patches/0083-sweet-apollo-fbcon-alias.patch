diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -134,6 +134,28 @@
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
 
+/* Write-combine alias installed by arm_vm_init() for the panel framebuffer. */
+uintptr_t
+sweet_early_fb_base(void)
+{
+	return (uintptr_t)early_fb;
+}
+
+void
+sweet_early_log(const char *fmt, ...)
+{
+	va_list ap;
+
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	va_start(ap, fmt);
+	_doprnt(fmt, &ap, sweet_early_putc, 16);
+	va_end(ap);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 void
 sweet_early_disable(void)
 {
