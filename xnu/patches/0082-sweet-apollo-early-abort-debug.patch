diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1510,6 +1510,17 @@
 handle_kernel_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr,
     fault_status_t fault_code, vm_prot_t fault_type, expected_fault_handler_t expected_fault_handler)
 {
+#if defined(SWEET)
+	/*
+	 * Before kmem_init() there is no kernel_map, so this routine cannot page
+	 * anything in; vm_fault(NULL, ...) would fault again and hide the first
+	 * fault behind an invalid-stack panic. Report the original abort instead.
+	 */
+	if (kernel_map == VM_MAP_NULL) {
+		panic_with_thread_kernel_state("SWEET EARLY ABORT: kernel_map not initialized", state);
+	}
+#endif
+
 	thread_t thread = current_thread();
 	bool recover = find_copyio_recovery_entry(state) != 0;
 
